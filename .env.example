# Сгенерируйте данные дефолтов. Используется docker-compose (корневой .env подхватывается автоматически).
# Скопируйте в .env: cp .env.example .env

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=rail
POSTGRES_PASSWORD=rail
POSTGRES_DB=railgis
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Порты сервисов ---
API_PORT=8000
FRONTEND_PORT=5173

# --- Секреты / безопасность ---
# Сгенерируйте надёжный key в продакшене, например: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-super-secret