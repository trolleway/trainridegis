# API (FastAPI). Для standalone-запуска: cp .env.example .env
# В docker-compose эти значения задаются в блоке environment службы api.

APP_ENV=development
DEBUG=true

# Подключение к БД (в docker-compose хост = db)
DATABASE_URL=postgresql+psycopg://rail:rail@db:5432/railgis
REDIS_URL=redis://redis:6379/0

# Безопасность
SECRET_KEY=change-me
JWT_ALGORITHM=HS256
TOKEN_TTL_DAYS=7

# Маршрутизация / геометрия
SNAP_RADIUS=0.01
SIMPLIFY_TOLERANCE=0.0005

# CORS (через запятую)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000