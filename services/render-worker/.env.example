# Render Worker (Celery). Для standalone: cp .env.example .env
# В docker-compose значения задаются в блоке environment службы render-worker.

APP_ENV=development

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Рендер в MVP — заглушка (mock); реальный PyQGIS — пост-MVP
RENDER_MODE=mock
RENDER_OUTPUT_DIR=/app/renders

DATABASE_URL=postgresql+psycopg://rail:rail@db:5432/railgis